  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.42",
    "@nuxt/eslint-config": "1.9.0",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/test-utils": "3.20.1",
    "@tailwindcss/vite": "4.1.16",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.38.0",
    "happy-dom": "20.0.8",
    "playwright-core": "1.56.1",
    "prettier": "3.6.2",
